<?xml version="1.0" encoding="utf-8"?>
<!--
    canRetrieveWindowContent is what lets the service read on-screen text at
    all. The event set is deliberately narrow — content changes, window
    switches and scrolls — because every event costs a debounce timer and a
    full re-read of the active window.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackVisual"
    android:accessibilityFlags="flagDefault|flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="200" />
